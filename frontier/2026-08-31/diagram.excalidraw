      "isDeleted": false,
      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "Instruction tuning narrows reported confidence into a band near the top. No variation left means nothing to correlate.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instruction tuning narrows reported confidence into a band near the top. No variation left means nothing to correlate.",
      "autoResize": true,
      "lineHeight": 1.25
