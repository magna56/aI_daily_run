      "isDeleted": false,
      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "Is a stated 80% right 80% of the time? Paradoxically at its best when the channel is most collapsed.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Is a stated 80% right 80% of the time? Paradoxically at its best when the channel is most collapsed.",
      "autoResize": true,
      "lineHeight": 1.25
