      "isDeleted": false,
      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "Are the two numerically close? A channel can sit close on average while carrying no per-item information.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Are the two numerically close? A channel can sit close on average while carrying no per-item information.",
      "autoResize": true,
      "lineHeight": 1.25
    },
