      "versionNonce": 730141215,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "Do the two move together across instances? This is the axis a threshold actually depends on, and the one that fails.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Do the two move together across instances? This is the axis a threshold actually depends on, and the one that fails.",
      "autoResize": true,
      "lineHeight": 1.25
    },
