      "isDeleted": false,
      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "A number the model says out loud. Produced like any other token; nothing in the architecture ties it to the softmax.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A number the model says out loud. Produced like any other token; nothing in the architecture ties it to the softmax.",
      "autoResize": true,
      "lineHeight": 1.25
    },
