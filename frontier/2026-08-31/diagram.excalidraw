      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "How much your bottom decile by spoken confidence overlaps the bottom decile by internal confidence. 10% is chance.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How much your bottom decile by spoken confidence overlaps the bottom decile by internal confidence. 10% is chance.",
