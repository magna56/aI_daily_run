      "isDeleted": false,
      "boundElements": null,
      "updated": 1788228210127,
      "link": null,
      "locked": false,
      "text": "The softmax probability over the answer tokens, or semantic entropy for free generation. Needs logprobs or repeated sampling.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The softmax probability over the answer tokens, or semantic entropy for free generation. Needs logprobs or repeated sampling.",
