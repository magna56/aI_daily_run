      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Scales with STORED depth, not executed depth, because all repeats of a layer share one checkpointed unit. This is the whole lever.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scales with STORED depth, not executed depth, because all repeats of a layer share one checkpointed unit. This is the whole lever.",
      "autoResize": true,
      "lineHeight": 1.25
    },
