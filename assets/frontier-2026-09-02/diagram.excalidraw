      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Run the whole stack, then run it again: 1 to 2 to 3 to 1 to 2 to 3. Used by prior looped models such as Ouro and Huginn.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Run the whole stack, then run it again: 1 to 2 to 3 to 1 to 2 to 3. Used by prior looped models such as Ouro and Huginn.",
      "autoResize": true,
      "lineHeight": 1.25
    },
