      "boundElements": null,
      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Halve stored layers, run each twice, then spend the freed memory on a doubled microbatch. Step three is the one that makes the first two pay.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Halve stored layers, run each twice, then spend the freed memory on a doubled microbatch. Step three is the one that makes the first two pay.",
      "autoResize": true,
      "lineHeight": 1.25
    },
