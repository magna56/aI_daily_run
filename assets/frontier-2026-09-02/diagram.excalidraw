      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Why it kept losing",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why it kept losing",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0068",
      "type": "text",
      "x": 645,
      "y": 890,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a68",
      "roundness": null,
      "seed": 800025867,
      "version": 1,
      "versionNonce": 714079449,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Recurrence is not free. Loop a model N times and training compute multiplies by N, so the honest baseline is a bigger model at the same cost.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recurrence is not free. Loop a model N times and training compute multiplies by N, so the honest baseline is a bigger model at the same cost.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
