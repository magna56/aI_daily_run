      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Run each layer twice in place: 1, 1, 2, 2, 3, 3. Identical arithmetic, reuse distance of one instead of the whole stack.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
