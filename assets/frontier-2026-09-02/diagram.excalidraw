    {
      "id": "adl_0065",
      "type": "text",
      "x": 65,
      "y": 890,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a65",
      "roundness": null,
      "seed": 918894717,
      "version": 1,
      "versionNonce": 228012077,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343575186,
      "link": null,
      "locked": false,
      "text": "Store fewer layers and run each of them more than once. You get the depth without storing the parameters.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Store fewer layers and run each of them more than once. You get the depth without storing the parameters.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0066",
      "type": "rectangle",
      "x": 630,
      "y": 852,
