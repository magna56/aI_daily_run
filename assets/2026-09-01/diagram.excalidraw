      "seed": 444723429,
      "version": 1,
      "versionNonce": 753888533,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "A test is an assertion about intent. If the agent misread the spec, its tests agree with the misreading and the suite goes green.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A test is an assertion about intent. If the agent misread the spec, its tests agree with the misreading and the suite goes green.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
