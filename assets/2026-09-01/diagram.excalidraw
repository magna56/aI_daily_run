      "isDeleted": false,
      "boundElements": null,
      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "A failure means your code is wrong, the port is wrong, or you differ deliberately. Label it before editing anything.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A failure means your code is wrong, the port is wrong, or you differ deliberately. Label it before editing anything.",
