      "isDeleted": false,
      "boundElements": null,
      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "Only the setup and call site change. Every assertion keeps its meaning, or the check is worthless.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only the setup and call site change. Every assertion keeps its meaning, or the check is worthless.",
      "autoResize": true,
      "lineHeight": 1.25
    },
