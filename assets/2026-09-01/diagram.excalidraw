      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "Differential testing",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Differential testing",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0058",
      "type": "text",
      "x": 645,
      "y": 866,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a58",
      "roundness": null,
      "seed": 720220022,
      "version": 1,
      "versionNonce": 393725396,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "Run the same inputs through two independent implementations and treat any disagreement as a defect to explain. Standard for compilers and database engines.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Run the same inputs through two independent implementations and treat any disagreement as a defect to explain. Standard for compilers and database engines.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
