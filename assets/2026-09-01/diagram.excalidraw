      "isDeleted": false,
      "boundElements": null,
      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "The second implementation is not one you write. It is a mature library that already does roughly what yours does, plus its tests.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The second implementation is not one you write. It is a mature library that already does roughly what yours does, plus its tests.",
      "autoResize": true,
      "lineHeight": 1.25
    },
