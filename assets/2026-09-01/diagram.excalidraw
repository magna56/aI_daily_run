      "versionNonce": 356957483,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788258690297,
      "link": null,
      "locked": false,
      "text": "Where your API has no equivalent, mark the test xfail with a reason. Never delete it. That list is everything your API cannot do, written by someone else.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Where your API has no equivalent, mark the test xfail with a reason. Never delete it. That list is everything your API cannot do, written by someone else.",
      "autoResize": true,
      "lineHeight": 1.25
    },
