    {
      "id": "adl_0037",
      "type": "text",
      "x": 80,
      "y": 394.0,
      "width": 1060,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a37",
      "roundness": null,
      "seed": 153877327,
      "version": 1,
      "versionNonce": 839777947,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787424664349,
      "link": null,
      "locked": false,
      "text": "The same turn-1 file read, re-sent at full size on every later turn. Cost = its size x the turns left.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The same turn-1 file read, re-sent at full size on every later turn. Cost = its size x the turns left.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0038",
      "type": "text",
      "x": 50,
      "y": 440.0,
      "width": 1100,
      "height": 34.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a38",
      "roundness": null,
      "seed": 733226190,
      "version": 1,
      "versionNonce": 503583366,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787424664349,
      "link": null,
      "locked": false,
      "text": "2. The cache matches on the PREFIX, so invalidation cascades forward",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. The cache matches on the PREFIX, so invalidation cascades forward",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0039",
      "type": "text",
      "x": 50,
      "y": 474.0,
      "width": 1100,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a39",
      "roundness": null,
      "seed": 518711952,
      "version": 1,
      "versionNonce": 868698409,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787424664349,
      "link": null,
      "locked": false,
      "text": "Render order is fixed: tools, then system, then messages. Change something early and everything behind it is rewritten at 1.25x instead of read at 0.1x.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Render order is fixed: tools, then system, then messages. Change something early and everything behind it is rewritten at 1.25x instead of read at 0.1x.",
      "autoResize": true,
      "lineHeight": 1.25
    },
