    {
      "id": "adl_0007",
      "type": "text",
      "x": 50,
      "y": 160,
      "width": 1100,
      "height": 34.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 268710498,
      "version": 1,
      "versionNonce": 624937372,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787424664349,
      "link": null,
      "locked": false,
      "text": "1. A token is not billed once \u2014 it is billed by every turn after it",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. A token is not billed once \u2014 it is billed by every turn after it",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0008",
      "type": "text",
      "x": 50,
      "y": 194,
      "width": 1100,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 588432336,
      "version": 1,
      "versionNonce": 135959523,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787424664349,
      "link": null,
      "locked": false,
      "text": "The transcript is append-only, but the whole thing is re-sent on every turn. So the stack is what you pay for, not the last block.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The transcript is append-only, but the whole thing is re-sent on every turn. So the stack is what you pay for, not the last block.",
      "autoResize": true,
      "lineHeight": 1.25
    },
