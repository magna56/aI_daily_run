      "link": null,
      "locked": false,
      "text": "Position is baked into the KV state, so a schema that moves is a schema recomputed",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Position is baked into the KV state, so a schema that moves is a schema recomputed",
      "autoResize": true,
      "lineHeight": 1.25
