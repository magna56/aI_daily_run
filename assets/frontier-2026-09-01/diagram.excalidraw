      "link": null,
      "locked": false,
      "text": "SWA(w, s)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SWA(w, s)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0080",
      "type": "text",
      "x": 645,
      "y": 1342,
      "width": 530,
      "height": 24.0,
