      "isDeleted": false,
      "boundElements": null,
      "updated": 1788259251870,
      "link": null,
      "locked": false,
      "text": "Those papers benchmarked against SINK-FREE windows, known since 2024 to collapse once the opening tokens scroll out.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Those papers benchmarked against SINK-FREE windows, known since 2024 to collapse once the opening tokens scroll out.",
      "autoResize": true,
      "lineHeight": 1.25
    },
