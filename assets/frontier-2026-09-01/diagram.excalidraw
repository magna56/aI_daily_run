      "isDeleted": false,
      "boundElements": null,
      "updated": 1788259251870,
      "link": null,
      "locked": false,
      "text": "w previous tokens plus the first s. In the paper w is 64 to 512 and s is fixed at 4. It is a mask, applied at inference.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "w previous tokens plus the first s. In the paper w is 64 to 512 and s is fixed at 4. It is a mask, applied at inference.",
      "autoResize": true,
      "lineHeight": 1.25
    },
