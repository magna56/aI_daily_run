      "boundElements": null,
      "updated": 1788259251870,
      "link": null,
      "locked": false,
      "text": "Every token adds a key and value that are kept for the whole conversation, so memory and cost climb without limit.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every token adds a key and value that are kept for the whole conversation, so memory and cost climb without limit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
