      "isDeleted": false,
      "boundElements": null,
      "updated": 1788259251870,
      "link": null,
      "locked": false,
      "text": "The cache stops growing at w + s entries per layer, so a 100K-token conversation costs the same per step as a 500-token one.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The cache stops growing at w + s entries per layer, so a 100K-token conversation costs the same per step as a 500-token one.",
      "autoResize": true,
      "lineHeight": 1.25
    },
