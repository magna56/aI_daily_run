      "boundElements": null,
      "updated": 1788259251870,
      "link": null,
      "locked": false,
      "text": "Swap the quadratic mechanism for a fixed-size state. Retrofitting a trained model costs 40M to 100B tokens of post-training.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Swap the quadratic mechanism for a fixed-size state. Retrofitting a trained model costs 40M to 100B tokens of post-training.",
