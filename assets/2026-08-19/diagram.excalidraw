      "versionNonce": 203401549,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "Frozen API critics and allowing draws performed the SAME or WORSE than the baseline. A static critic is not a critic - Alice just routes around it.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frozen API critics and allowing draws performed the SAME or WORSE than the baseline. A static critic is not a critic - Alice just routes around it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
