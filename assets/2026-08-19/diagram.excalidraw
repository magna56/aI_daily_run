      "isDeleted": false,
      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "The real win. Debate holds peak accuracy; the baseline overshoots and degrades. Without labels you cannot detect the peak, so you cannot early-stop.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The real win. Debate holds peak accuracy; the baseline overshoots and degrades. Without labels you cannot detect the peak, so you cannot early-stop.",
      "autoResize": true,
      "lineHeight": 1.25
    },
