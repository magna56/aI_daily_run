    {
      "id": "adl_0010",
      "type": "text",
      "x": 65,
      "y": 238,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
