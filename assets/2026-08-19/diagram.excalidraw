      "isDeleted": false,
      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "Alice writes a solution, Bob critiques it, a frozen WEAK judge picks a winner. Alice gets r, Bob gets 1-r. One shared policy plays both roles via self-play.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Alice writes a solution, Bob critiques it, a frozen WEAK judge picks a winner. Alice gets r, Bob gets 1-r. One shared policy plays both roles via self-play.",
      "autoResize": true,
      "lineHeight": 1.25
    },
