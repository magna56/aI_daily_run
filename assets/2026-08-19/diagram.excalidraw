    {
      "id": "adl_0013",
      "type": "text",
      "x": 645,
      "y": 238,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a13",
      "roundness": null,
      "seed": 592322751,
      "version": 1,
      "versionNonce": 399426316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "Treat the judge as a binary classifier vs ground truth. Matthews corr. coeff. uses all 4 confusion quadrants. Reward UP + MCC DOWN = you are being hacked.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Treat the judge as a binary classifier vs ground truth. Matthews corr. coeff. uses all 4 confusion quadrants. Reward UP + MCC DOWN = you are being hacked.",
      "autoResize": true,
      "lineHeight": 1.25
    },
