      "index": "a10",
      "roundness": null,
      "seed": 170914428,
      "version": 1,
      "versionNonce": 118150476,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "Policy exploits systematic judge errors. Reward climbs to 0.98 while accuracy and judge MCC collapse. Worst exactly when the judge is weaker than the policy.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Policy exploits systematic judge errors. Reward climbs to 0.98 while accuracy and judge MCC collapse. Worst exactly when the judge is weaker than the policy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
