      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "Gemini 2.5 Flash Lite (65.6% as a solver) judging a 2.5 Flash-class policy. Sampled 8x, reward = mean vote share. Models real scalable oversight.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
