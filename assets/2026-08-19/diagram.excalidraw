      "isDeleted": false,
      "boundElements": null,
      "updated": 1787145809002,
      "link": null,
      "locked": false,
      "text": "Honest Broker vs Incentive-Aligned prompts produced identical adversarial behaviour. The 1-r reward overrode the instruction entirely.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Honest Broker vs Incentive-Aligned prompts produced identical adversarial behaviour. The 1-r reward overrode the instruction entirely.",
      "autoResize": true,
      "lineHeight": 1.25
    },
