      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "Reduction order",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reduction order",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0056",
      "type": "text",
      "x": 645,
      "y": 890,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a56",
      "roundness": null,
      "seed": 420237519,
      "version": 1,
      "versionNonce": 315638929,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "Every kernel sums its partial results in some order. Split-K counts, tree reductions and thread layouts all pick a different one.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every kernel sums its partial results in some order. Split-K counts, tree reductions and thread layouts all pick a different one.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0057",
      "type": "rectangle",
      "x": 50,
      "y": 982,
