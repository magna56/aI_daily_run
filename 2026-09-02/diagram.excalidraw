      "seed": 167698556,
      "version": 1,
      "versionNonce": 609465241,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "The spread between two runtimes on identical input. A real regression smaller than it is invisible; a test asserting exact equality across it is flaky.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The spread between two runtimes on identical input. A real regression smaller than it is invisible; a test asserting exact equality across it is flaky.",
      "autoResize": true,
      "lineHeight": 1.25
    },
