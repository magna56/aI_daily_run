      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "The RL guard that discards tokens whose rollout and training probabilities disagree. Small numeric gaps become large behavioural ones here.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The RL guard that discards tokens whose rollout and training probabilities disagree. Small numeric gaps become large behavioural ones here.",
      "autoResize": true,
      "lineHeight": 1.25
    },
