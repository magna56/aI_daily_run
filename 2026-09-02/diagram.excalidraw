      "link": null,
      "locked": false,
      "text": "Non-associativity",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-associativity",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0053",
      "type": "text",
      "x": 65,
      "y": 890,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a53",
      "roundness": null,
      "seed": 478929151,
      "version": 1,
      "versionNonce": 765041528,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "Floating-point addition rounds at every step, so (a+b)+c and a+(b+c) can differ. This is correct arithmetic, not a bug.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Floating-point addition rounds at every step, so (a+b)+c and a+(b+c) can differ. This is correct arithmetic, not a bug.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0054",
