      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "Batch invariance",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Batch invariance",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adl_0059",
      "type": "text",
      "x": 65,
      "y": 1020,
      "width": 530,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a59",
      "roundness": null,
      "seed": 546848563,
      "version": 1,
      "versionNonce": 300401395,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "A kernel where neither your batch neighbours nor the batch size change your result. Ordinary kernels are not batch-invariant.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A kernel where neither your batch neighbours nor the batch size change your result. Ordinary kernels are not batch-invariant.",
      "autoResize": true,
      "lineHeight": 1.25
    },
