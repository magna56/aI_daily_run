      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "A second artifact beside the weights: kernel implementation, accumulation dtype, split counts, and which parallel sizes are bitwise safe.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A second artifact beside the weights: kernel implementation, accumulation dtype, split counts, and which parallel sizes are bitwise safe.",
      "autoResize": true,
      "lineHeight": 1.25
    },
