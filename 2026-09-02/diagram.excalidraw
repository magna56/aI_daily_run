      "isDeleted": false,
      "boundElements": null,
      "updated": 1788343097242,
      "link": null,
      "locked": false,
      "text": "Bitwise agreement is not free: 31.3% slower generation, 18.6% slower training, 25.3% on the full step.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bitwise agreement is not free: 31.3% slower generation, 18.6% slower training, 25.3% on the full step.",
      "autoResize": true,
      "lineHeight": 1.25
    },
