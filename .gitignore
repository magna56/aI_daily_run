# Local Python env — never publish (118M)
.venv/
__pycache__/
*.pyc

# Local Claude session state. NOT the whole of .claude/ — the skills that
# generate and publish these sessions live in .claude/skills/ and must travel
# with the repo, so that cloning it is the entire install. See SETUP.md.
.claude/settings.local.json
.claude/scheduled_tasks.json

# macOS
.DS_Store

# Scheduler logs
.logs/

# Build output — regenerated by `make site`, published to Cloudflare Pages + gh-pages
site/

# Wrangler's local cache/config for the Cloudflare Pages deploy step in deploy.sh
.wrangler/

# Cached code_example.py run results (keyed by source hash)
.build-cache.json

# Generated short videos (see docs/video-pipeline.md) — pipeline output at repo root only
/videos/

# Playwright install for automated visualize capture
.video-deps/
.env
.dev.vars
.mcp.json
