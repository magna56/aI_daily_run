# Local Python env — never publish (118M)
.venv/
__pycache__/
*.pyc

# Local Claude session state. NOT the whole of .claude/ — the skills that
# generate and publish these sessions live in .claude/skills/ and must travel
# with the repo, so that cloning it is the entire install. See SETUP.md.
.claude/settings.local.json
.claude/scheduled_tasks.json

# macOS
.DS_Store

# Scheduler logs
.logs/

# Build output — regenerated by `make site`, published to the gh-pages branch
site/

# Cached code_example.py run results (keyed by source hash)
.build-cache.json
.env
.mcp.json
