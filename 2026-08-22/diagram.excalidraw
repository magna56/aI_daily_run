    {
      "id": "adl_0009",
      "type": "text",
      "x": 70,
      "y": 220,
      "width": 1060,
      "height": 29.0,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 273494439,
      "version": 1,
      "versionNonce": 978189445,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787424032288,
      "link": null,
      "locked": false,
      "text": "An agent conversation is append-only, but the whole thing gets re-sent to the model on every turn, so a token you add early gets billed again and again as the session goes on. Prompt caching only pays off if you never touch the front of that prefix: change one byte near the start and everything after it must be rewritten at 1.25x instead of read at 0.1x. Claude Code, Cursor, and the MCP roadmap all shipped changes this month aimed at the same fix - keep heavy reading out of the main transcript, since a bigger context window just means more room to re-read, not a free upgrade.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An agent conversation is append-only, but the whole thing gets re-sent to the model on every turn, so a token you add early gets billed again and again as the session goes on. Prompt caching only pays off if you never touch the front of that prefix: change one byte near the start and everything after it must be rewritten at 1.25x instead of read at 0.1x. Claude Code, Cursor, and the MCP roadmap all shipped changes this month aimed at the same fix - keep heavy reading out of the main transcript, since a bigger context window just means more room to re-read, not a free upgrade.",
      "autoResize": true,
      "lineHeight": 1.25
    },
